{
  "name": "nestworth",
  "main": "expo-router/entry",
  "version": "1.5.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "db:rehearse": "node scripts/rehearse-migration.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:web": "playwright test",
    "e2e:web:ui": "playwright test --ui",
    "e2e:web:report": "playwright show-report",
    "e2e:mobile": "sh -c 'set -a && . ./.env.e2e && set +a && maestro test -e E2E_TEST_EMAIL=\"$E2E_TEST_EMAIL\" -e E2E_TEST_PASSWORD=\"$E2E_TEST_PASSWORD\" e2e/mobile/flows'",
    "electron:tsc": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:tsc && npx expo export -p web && electron electron/dist-main/main.js",
    "electron:build": "npx expo export -p web && npm run electron:tsc && electron-builder --mac",
    "release": "node scripts/release.js",
    "release:desktop": "node scripts/release-desktop.js",
    "version": "node scripts/sync-app-version.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/query-async-storage-persister": "^5.96.2",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-query-persist-client": "^5.96.2",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "^25.8.0",
    "@types/react": "~19.2.10",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "supabase": "2.122.0",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.10"
  },
  "private": true,
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "electron-winstaller@5.4.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
